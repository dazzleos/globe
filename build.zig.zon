            .url = "git+https://github.com/dazzleos/dazzle#95012975e23083179d32873380beb274c2406ea7",
            .hash = "dazzle-0.0.0-ze61IJO5sQBxkaBvcFbqa4zg3KV6s2rTZ0A5wBAO2ikj",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "LICENSE",
    },
}
