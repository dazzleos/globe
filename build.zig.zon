.{
    .name = .globe,
    .version = "0.0.0",
    .fingerprint = 0xb558041453c999c3, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // Dazzle's modules (kete_vc4 and the rest) and tools, which
